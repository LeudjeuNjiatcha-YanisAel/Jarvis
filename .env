# Clé API (Mettez ici votre clé Gemini, Groq, Cerebras ou xAI)
API_KEY=votre_cle_ici

# ---------------------------------------------------------
# Choisissez votre IA en décommentant (enlevant le #) la section voulue :
# Laissez les autres sections commentées !
# ---------------------------------------------------------

# --- Pour GEMINI (Google) ---
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-1.5-flash

